# @ava/api — copy to .env for local dev (never commit .env).
PORT=8080
# Google API key for Gemini Omni Flash. Server-side ONLY. In production this is
# a Secret Manager secret mounted by Cloud Run, not a committed value.
GOOGLE_API_KEY=
OMNI_FLASH_MODEL=gemini-omni-flash
USD_PER_SECOND=0.10
ALLOW_ORIGIN=http://localhost:5173
