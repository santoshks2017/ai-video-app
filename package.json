{
  "name": "ai-video-app",
  "version": "0.1.0",
  "private": true,
  "description": "AI-generated dealer ad-slot videos for CarDekho's design team.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "jobs/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @ava/shared",
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev --workspace @ava/web",
    "dev:api": "npm run dev --workspace @ava/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
